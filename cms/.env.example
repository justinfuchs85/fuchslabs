# Postgres connection string.
# Production (Supabase): Connect → Session pooler, then swap in the CMS login:
#   postgres://fuchs_labs_cms.<project-ref>:<password>@<pooler-host>:5432/postgres
# Local: any Postgres works; the initial migration creates the "payload" schema.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/fuchs_labs

# Long random string. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me

# Where the Astro site runs (for CORS).
WEB_ORIGIN=http://localhost:4321

# Optional: deploy hook that rebuilds the static site when content changes.
DEPLOY_HOOK_URL=

# Optional: first admin, created by `npm run seed`. (Or use the "create first user" screen at /admin.)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
